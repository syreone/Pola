{
  "expo": {
    "name": "Pola",
    "slug": "pola",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pola",
    "splash": {
      "image": "./assets/pola-logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2FF"
    },
    "android": {
      "package": "com.demo.pola",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#EEF2FF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.demo.pola"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pola to scan Solana Pay QR codes."
        }
      ]
    ]
  }
}
